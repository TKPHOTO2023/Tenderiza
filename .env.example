DATABASE_URL="postgresql://tenderiza:tenderiza@localhost:5432/tenderiza?schema=public"

# Local filesystem path where uploaded compliance documents are stored when
# BLOB_READ_WRITE_TOKEN is not set (local dev). Structured to be swappable
# for other object storage later (see src/lib/storage.ts).
UPLOAD_DIR="./uploads"

# Set this (Vercel adds it automatically when you attach a Blob store to the
# project) to switch document storage over to Vercel Blob instead of local
# disk. Required in any deployment where the filesystem isn't persistent.
# BLOB_READ_WRITE_TOKEN=

# Encrypts connected mailbox passwords at rest (AES-256-GCM). Set to a long
# random value — without it, connecting a sending mailbox is refused.
MAIL_ENCRYPTION_KEY=

# The platform's own outgoing mailbox, used for password reset emails sent by
# Tenderiza itself. Separate from the per-company mailbox a customer connects
# on the Brand page, which sends their bids as them. Any SMTP host works; a
# hostdigi mailbox is set up as mail.<domain> on port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The visible From address. Defaults to SMTP_USER. Many hosts, hostdigi
# included, will only send From an address on the authenticated mailbox's
# own domain.
SMTP_FROM=
# Leave unset: implicit TLS is assumed on port 465, STARTTLS otherwise.
# SMTP_SECURE=true

# Used to build the reset link in those emails. On Vercel this falls back to
# the production domain automatically, so it's only needed if you want the
# links to point somewhere else.
# NEXT_PUBLIC_APP_URL=https://tenderiza.co.za
