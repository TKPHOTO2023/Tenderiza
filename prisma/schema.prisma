// Tenderiza — Phase 1 data model
// Designed so Phases 2-5 (tender ingestion, eligibility scoring,
// document drafting, review & submission) can be layered on without
// reshaping these core tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core company profile
// ---------------------------------------------------------------------------

enum CompanyType {
  PTY_LTD
  CC
  SOLE_PROPRIETOR
  PARTNERSHIP
  NPO
  TRUST
  OTHER
}

enum BbbeeLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
  LEVEL_6
  LEVEL_7
  LEVEL_8
  EXEMPT_MICRO_ENTERPRISE
  QUALIFYING_SMALL_ENTERPRISE
  NON_COMPLIANT
}

enum CsdStatus {
  NOT_REGISTERED
  PENDING
  REGISTERED
  SUSPENDED
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTHERN_CAPE
  NORTH_WEST
  WESTERN_CAPE
}

enum OnboardingStep {
  COMPANY_BASICS
  COMPLIANCE
  CAPABILITY
  DOCUMENTS
  REVIEW
  COMPLETE
}

model Company {
  id String @id @default(cuid())

  // Step 1: Company basics
  companyName        String?
  tradingName         String?
  registrationNumber  String?
  vatNumber           String?
  companyType         CompanyType?
  contactPersonName   String?
  contactEmail        String?
  contactPhone        String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  postalCode          String?
  operatingProvinces  Province[] @default([])
  website             String?
  description         String?

  // Step 2: Compliance & registration status
  csdRegistrationNumber String?
  csdStatus             CsdStatus?
  taxComplianceStatusPin String?
  taxComplianceExpiry    DateTime?
  bbbeeLevel             BbbeeLevel?
  bbbeeCertificateExpiry DateTime?
  cidbRegistrationNumber String?
  cidbGrade              String?
  cidbClassOfWork        String?

  // Step 3: Business capability
  teamSize        Int?
  capacityNotes   String?

  // Onboarding progress tracking (supports save-and-resume)
  currentStep        OnboardingStep @default(COMPANY_BASICS)
  onboardingComplete Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   CompanyCategory[]
  accreditations CompanyAccreditation[]
  references   CompanyReference[]
  documents    CompanyDocument[]
  matches      Match[]
  drafts       Draft[]

  @@map("companies")
}

// ---------------------------------------------------------------------------
// Sector / industry categories (UNSPSC-style), many-to-many with company
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. UNSPSC-style segment code
  name        String
  description String?

  companies CompanyCategory[]

  @@map("categories")
}

model CompanyCategory {
  id         String   @id @default(cuid())
  companyId  String
  categoryId String
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([companyId, categoryId])
  @@map("company_categories")
}

// ---------------------------------------------------------------------------
// Sector-specific accreditations (NHBRC, ISO, etc.) — custom & extensible
// ---------------------------------------------------------------------------

model CompanyAccreditation {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  referenceNo  String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_accreditations")
}

// ---------------------------------------------------------------------------
// Past project references
// ---------------------------------------------------------------------------

model CompanyReference {
  id                String   @id @default(cuid())
  companyId         String
  clientName        String
  projectDescription String
  value             Decimal? @db.Decimal(14, 2)
  year              Int?
  createdAt         DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_references")
}

// ---------------------------------------------------------------------------
// Document types (extensible catalog, not hardcoded) & uploaded documents
// ---------------------------------------------------------------------------

model DocumentType {
  id           String  @id @default(cuid())
  code         String  @unique
  label        String
  description  String?
  requiresExpiry Boolean @default(false)
  isCustom     Boolean @default(false)
  createdAt    DateTime @default(now())

  documents CompanyDocument[]

  @@map("document_types")
}

model CompanyDocument {
  id             String    @id @default(cuid())
  companyId      String
  documentTypeId String
  fileName       String
  fileUrl        String
  mimeType       String?
  fileSizeBytes  Int?
  expiryDate     DateTime?
  uploadedAt     DateTime  @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  @@map("company_documents")
}

// ---------------------------------------------------------------------------
// Phase 2: Tender ingestion (National Treasury eTenders OCDS API)
// ---------------------------------------------------------------------------

// Normalized from OCDS's tenderStatus codelist (planning/planned/active/
// cancelled/unsuccessful/withdrawn/complete) into a small clean set. Category/
// sector mapping is deliberately NOT modeled here — that's Phase 3's job,
// which will map `category` (whatever OCDS gives us) onto our own Category
// taxonomy for eligibility scoring.
enum TenderStatus {
  PLANNED
  OPEN
  CLOSED
  CANCELLED
  UNKNOWN
}

// Phase 6: classified from the tender document's own wording/structure, not
// guessed from value alone — see src/lib/tender-extraction.ts.
enum ProcurementType {
  RFQ // request for quotation — typically below a Rand-value threshold
  RFP // formal competitive bid (includes standard SBD-form tenders)
  RFI // request for information — no priced bid response needed
  UNKNOWN // not yet extracted, or extraction couldn't tell
}

model Tender {
  id String @id @default(cuid())

  ocid String @unique // OCDS unique contracting process ID — dedup key

  title       String?
  description String?

  buyerName String?
  province  String?
  category  String? // raw OCDS classification/description, unmapped

  status TenderStatus @default(UNKNOWN)

  publishedDate DateTime?
  closingDate   DateTime?

  estimatedValue Decimal? @db.Decimal(16, 2)
  currency       String?

  documentUrls String[] @default([])
  sourceUrl    String?

  rawData Json // full original OCDS release, for anything not normalized above

  // AI-generated "what must we deliver" summary, extracted from the tender's
  // linked PDF documents (+ OCDS description as a fallback). Cached here so
  // it's generated once, on demand, rather than on every page view — see
  // src/lib/tender-summary.ts.
  requirementsSummary            Json?
  requirementsSummaryGeneratedAt DateTime?

  // AI-generated, generic market-rate quote guidance — see
  // src/lib/tender-cost-estimate.ts. Reasoned independently of any official
  // OCDS estimatedValue every time; not personalized to any one company.
  costEstimate            Json?
  costEstimateGeneratedAt DateTime?

  // Phase 3: AI-extracted eligibility-relevant requirements (required
  // B-BBEE level, CIDB grade, compulsory briefing, functionality threshold)
  // pulled from the tender's PDF documents — see src/lib/tender-extraction.ts.
  // Cached and only re-run when explicitly requested (documents rarely
  // change after publication), unlike requirementsSummary/costEstimate
  // above which are narrative and re-generated freely.
  extractedRequirements   Json?
  requirementsExtractedAt DateTime?

  // Phase 6: procurement type (RFQ/RFP/RFI) and, when the tender includes
  // one, its itemized pricing schedule — both extracted in the same Layer 2
  // AI pass as extractedRequirements (see src/lib/tender-extraction.ts).
  // Pricing schedule rows never carry a price — line description/quantity/
  // unit only, so Phase 4 can render the bidder's own blank price cells.
  procurementType ProcurementType @default(UNKNOWN)
  pricingSchedule Json? // PricingScheduleItem[] — see src/lib/tender-extraction.ts

  firstSeenAt   DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  matches Match[]
  drafts  Draft[]

  @@index([status, closingDate])
  @@index([province])
  @@map("tenders")
}

// ---------------------------------------------------------------------------
// Phase 3: Eligibility matching
// ---------------------------------------------------------------------------

enum MatchStatus {
  ELIGIBLE
  PARTIAL
  NOT_ELIGIBLE
  NEEDS_REVIEW
}

model Match {
  id String @id @default(cuid())

  companyId String
  tenderId  String

  // Layer 1 — structural, computed from OCDS metadata + company profile,
  // no AI call needed.
  categoryMatch Boolean
  provinceMatch Boolean

  // Layer 2 — hard pass/fail/needs-review breakdown per extracted
  // requirement, e.g. [{ requirement: "CIDB Grade", status: "fail",
  // detail: "Requires Grade 6 — your profile has Grade 4" }]. Empty until
  // extraction has run for this tender.
  hardChecks Json @default("[]")

  status  MatchStatus
  reasons String[] @default([]) // short human-readable "why" bullets

  computedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tender  Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([companyId, tenderId])
  @@index([companyId, status])
  @@map("matches")
}

model TenderSyncLog {
  id String @id @default(cuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  releasesFetched Int @default(0)
  tendersCreated  Int @default(0)
  tendersUpdated  Int @default(0)

  success      Boolean @default(false)
  errorMessage String?

  @@map("tender_sync_logs")
}

// ---------------------------------------------------------------------------
// Phase 4: Document drafting
// ---------------------------------------------------------------------------

// Phase 5 replaces the original GENERATED/EDITED/FINALIZED lifecycle with an
// explicit review-and-submission gate. DRAFT is the Phase 4 starting point;
// everything from UNDER_REVIEW onward is Phase 5 — see
// src/lib/submission-workflow.ts for the only place transitions happen.
enum DraftStatus {
  DRAFT // generated (or since edited/regenerated), not yet sent for review
  UNDER_REVIEW // human is actively reviewing the checklist + documents
  APPROVED // human explicitly confirmed checklist + pricing were reviewed — still NOT submitted anywhere
  SUBMITTED // human confirms they submitted this for real, outside the app
  NOT_SUBMITTING // human decided not to pursue this one after all
}

enum SubmissionMethod {
  MANUAL // submitted outside the app (portal upload, physical bid box, etc.) — the default, always available
  ELECTRONIC // a confirmed, wired-up direct-submission integration for a specific portal — none built yet
}

model Draft {
  id String @id @default(cuid())

  companyId String
  tenderId  String

  // Each entry: { label, url, kind: "official_form_filled" | "generated_equivalent" | "technical_proposal" }
  // Every document referenced here is watermarked DRAFT in its own content,
  // not just flagged in the UI — see src/lib/draft-documents.ts.
  documentUrls Json @default("[]")

  // Per-tender checklist: Phase 1 document-expiry status, Phase 3 hard-check
  // pass/fail/needs_review, and standard SBD declarations still needing the
  // bidder's own signature — see src/lib/compliance-checklist.ts.
  complianceChecklist Json @default("[]")

  status DraftStatus @default(DRAFT)

  // Phase 5: review & submission gate. Never set by anything other than an
  // explicit, in-the-moment human action — see src/lib/submission-workflow.ts.
  reviewStartedAt DateTime?

  pricingConfirmed   Boolean   @default(false) // human explicitly confirmed final pricing was checked — never calculated by the app
  pricingConfirmedAt DateTime?
  pricingNotes       String?

  approvedAt DateTime? // requires pricingConfirmed=true at the moment of approval

  briefingAttended Boolean @default(false) // human marks the tender's compulsory briefing (if any) as attended

  submittedAt        DateTime?
  submissionMethod   SubmissionMethod?
  submissionNotes    String?

  notSubmittingReason String?

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tender     Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  statusLogs DraftStatusLog[]

  @@unique([companyId, tenderId])
  @@map("drafts")
}

// ---------------------------------------------------------------------------
// Marketing site: Contact Us submissions
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Phase 5: Review, approval & submission audit trail
// ---------------------------------------------------------------------------

// One row per status transition, forever — the record a company would show
// to prove their own process was diligent if ever questioned. Nothing here
// is ever updated or deleted, only appended to.
model DraftStatusLog {
  id String @id @default(cuid())

  draftId    String
  fromStatus DraftStatus?
  toStatus   DraftStatus
  note       String?
  createdAt  DateTime     @default(now())

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@map("draft_status_logs")
}
